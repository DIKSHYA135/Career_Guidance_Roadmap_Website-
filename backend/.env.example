# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Strong random secret for signing JWTs. MUST be 32+ characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Optional: how long issued tokens stay valid (default 24h)
JWT_EXPIRES_IN=24h

# Optional: comma-separated list of allowed browser origins for CORS.
# Example: https://yourdomain.com,https://www.yourdomain.com
# If left empty, localhost is allowed in development.
ALLOWED_ORIGINS=

# Set to "production" when deploying. Hides internal error details from clients.
NODE_ENV=development

# Port the API listens on (default 5000)
PORT=5000





